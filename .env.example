# Frontend → backend wiring (build-time). Vite exposes PUBLIC_* to the client,
# so this decides whether the site shows live data or curated demo data.
#
# Leave unset (or empty) → demo mode: every dashboard widget keeps rendering
# sample data. The site never breaks without a backend.
#
# Option A — Tailnet-only (recommended while the host is behind Tailscale):
#   PUBLIC_API_BASE_URL=http://hermes:8787
#
# Option B — public HTTPS behind the backend's JWT auth + CORS (do this only
# once the exposure + CORS work in docs/DEPLOYMENT.md is done):
#   PUBLIC_API_BASE_URL=https://api.example.com
#
# Operators can also override at runtime without a rebuild:
#   localStorage['openstrata-api-base'] = 'http://<host>:8787'
PUBLIC_API_BASE_URL=
