[TEMPLATE]
# Frontend → backend wiring (build-time). Vite inlines PUBLIC_* into the client
# bundle (see envPrefix in vite.config.ts), so this decides whether the site
# shows live data or curated demo data.
#
# Leave unset (or empty) → demo mode: every dashboard widget keeps rendering
# sample data. The site never breaks without a backend.
#
# Option 1 — one host serves both the site and the API (simplest):
#   PUBLIC_API_BASE_URL=/
#   The value `/` means "this same origin", so no URL has to be written down and
#   the API needs no CORS at all (same origin never asks). The origin is known
#   only once the page is running, so before hydration the widgets still show
#   demo data, exactly as the runtime override below does.
#
# Option 2 — Tailnet-only (site on Cloudflare, API on your own host):
#   PUBLIC_API_BASE_URL=http://hermes:8787
#   and on the host: CORS_ORIGINS=https://openstrata.giveabit.io
#   (the browser blocks the call without it — see backend/.env.example)
#
# Option 3 — public HTTPS behind the API's JWT auth + CORS:
#   PUBLIC_API_BASE_URL=https://api.example.com
#   and on the host: CORS_ORIGINS=https://openstrata.giveabit.io
#
# Operators can also override at runtime without a rebuild (wins over all of the
# above):
#   localStorage['openstrata-api-base'] = 'http://<host>:8787'
#
# The value must be `/`, `same-origin`, or an absolute http(s) URL. Anything else
# (a bare path, a protocol-relative `//host`) is ignored and the site stays in
# demo mode, because appending /api/v1/... to an untrusted base would hand the
# council's bearer token to that host.
PUBLIC_API_BASE_URL=

# Client-side Sentry (SvelteKit) — consumed by src/hooks.client.ts as VITE_PUBLIC_SENTRY_DSN.
# Leave empty to disable; error capture stays dormant until a DSN is set.
VITE_PUBLIC_SENTRY_DSN=
