{
  "name": "openstrata",
  "version": "0.3.60",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "prebuild": "node scripts/generate-csp.mjs && node scripts/generate-sitemap.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "audit:i18n": "node scripts/audit-i18n.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:security": "node scripts/check-secret-hygiene.mjs",
    "hooks:install": "git config core.hooksPath .githooks && echo 'Git hooks enabled: pre-push applies the migrations before they reach main.'",
    "db:check": "node backend/scripts/prepush-db-check.mjs",
    "db:up": "node backend/scripts/db-local.mjs up",
    "db:down": "node backend/scripts/db-local.mjs down",
    "db:status": "node backend/scripts/db-local.mjs status",
    "db:url": "node backend/scripts/db-local.mjs url",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "icons": "node scripts/generate-icons.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^7.0.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.3.0",
    "@types/qrcode": "^1.5.6",
    "jsdom": "^30.1.3",
    "svelte": "^5.25.0",
    "svelte-check": "^4.3.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.4.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0"
  },
  "dependencies": {
    "@sentry/sveltekit": "^11.9.0",
    "qrcode": "^1.5.4"
  }
}
