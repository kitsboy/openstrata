# ---------------------------------------------------------------------------
# Phase 3 backend environment. Copy to `.env` and edit. Nothing here is a
# production secret — these are local-dev defaults. Use a real secret manager
# (or at minimum a strong password) before any real community data.
# ---------------------------------------------------------------------------

# Postgres (singleton pgvector container)
POSTGRES_USER=openstrata
POSTGRES_PASSWORD=openstrata-dev-only
POSTGRES_DB=openstrata
POSTGRES_PORT=5432

# Fastify API
API_PORT=8080
HOST=0.0.0.0
DATABASE_URL=postgres://openstrata:openstrata-dev-only@localhost:5432/openstrata

# Rosa RAG — local Ollama endpoints (host.docker.internal reaches the host).
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Sentinel embedding model; swap for the real model once selected.
OLLAMA_EMBED_MODEL=${OLLAMA_EMBED_MODEL:-nomic-embed-text}
# Strict-RAG answer model.
OLLAMA_CHAT_MODEL=${OLLAMA_CHAT_MODEL:-llama3.2}
# pgvector collection/table prefix for the BC SPA/RTA/CRT corpus.
VECTOR_COLLECTION=bc_spa_rta_crt

# Ziggy — treasury tuning (development only).
CRF_MANDATORY_PCT=10

# Reconcile scan window (days) for auto-matching inbound transfers.
RECON_SCAN_DAYS=90