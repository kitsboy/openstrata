# ---------------------------------------------------------------------------
# Phase 3 backend environment. Copy to `.env` and edit. Nothing here is a
# production secret — these are local-dev defaults. Use a real secret manager
# (or at minimum a strong password) before any real community data.
# ---------------------------------------------------------------------------

# Postgres (singleton pgvector container)
POSTGRES_USER=openstrata
POSTGRES_PASSWORD=openstrata-dev-only
POSTGRES_DB=openstrata
POSTGRES_PORT=5432

# Fastify API
API_PORT=8080
HOST=0.0.0.0
DATABASE_URL=postgres://openstrata:openstrata-dev-only@localhost:5432/openstrata

# Rosa RAG — local Ollama endpoints (host.docker.internal reaches the host).
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Sentinel embedding model; swap for the real model once selected.
OLLAMA_EMBED_MODEL=${OLLAMA_EMBED_MODEL:-nomic-embed-text}
# Strict-RAG answer model.
OLLAMA_CHAT_MODEL=${OLLAMA_CHAT_MODEL:-llama3.2}
# pgvector collection/table prefix for the BC SPA/RTA/CRT corpus.
VECTOR_COLLECTION=bc_spa_rta_crt

# Ziggy — treasury tuning (development only).
CRF_MANDATORY_PCT=10

# ---------------------------------------------------------------------------
# Auth (multi-tenant councils). AUTH_SECRET signs the HS256 bearer JWTs —
# generate a strong value before any real data, e.g.:
#   openssl rand -base64 48
# ---------------------------------------------------------------------------
AUTH_SECRET=dev-only-insecure-secret-change-me
# Bearer token lifetime in seconds (12 hours).
AUTH_TOKEN_TTL=43200
# Brute-force throttle for the open auth surface: max failed attempts per
# 15-minute window, keyed per email + per IP. Successful logins clear the bucket.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Reconcile scan window (days) for auto-matching inbound transfers.
RECON_SCAN_DAYS=90

# ---------------------------------------------------------------------------
# Sovereign payment rails (Bitcoin + Layer-2). All off by default until the
# corresponding daemon / service is provisioned on the host.
# ---------------------------------------------------------------------------
# Bitcoin on-chain node (bitcoind / LND) — endpoint is used to inspect wallets.
BITCOIN_RAIL_ENABLED=false
BITCOIN_NODE_URL=rpc://127.0.0.1:8332

# Lightning Network via LND. When enabled, quotePayment enforces the LNURL
# 15-minute CAD rate-lock window.
LIGHTNING_RAIL_ENABLED=false
LND_URL=grpc://127.0.0.1:10009
LIGHTNING_NETWORK=mainnet

# Liquid Network (Elements) — JSON-RPC / Liquid Service provide asset wallets.
LIQUID_RAIL_ENABLED=false
LIQUID_URL=http://127.0.0.1:7041

# PayNym (BIP-47) — stateless payment notification endpoint (PayNym bot / BIP78).
PAYNYM_RAIL_ENABLED=false
PAYNYM_NOTIFIER_URL=

# Nostr — comma-separated relay list; unit identity / receipts / DMs.
NOSTR_RAIL_ENABLED=false
NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol