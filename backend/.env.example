# ---------------------------------------------------------------------------
# Phase 3 backend environment. Copy to `.env` and edit. Nothing here is a
# production secret — these are local-dev defaults. Use a real secret manager
# (or at minimum a strong password) before any real community data.
#
# Deployment model (see README + /docs/DEPLOYMENT.md):
#   - Self-hosted behind Tailscale. Each operator runs their own Tailscale
#     tailnet and joins the host to it. The API binds to 0.0.0.0 inside the
#     container; Tailscale is the access layer (tailnet ACLs + ssh console),
#     NOT a public internet endpoint. Never expose Postgres to the wide internet.
#   - Rosa Ollama can run on the same host (host.docker.internal) OR in the
#     operator's own Tailscale tailnet at an HTTPS/Ollama-tailnet address.
#   - Any user can bring their own Tailscale: the host only needs to be a
#     Tailscale node in the operator's tailnet; the API is reachable at the
#     host's Tailscale MagicDNS name (e.g. openstrata-host.tailnet-name.ts.net)
#     once joined.
# ---------------------------------------------------------------------------

# --- Postgres (singleton pgvector container) ---
POSTGRES_USER=openstrata
POSTGRES_PASSWORD=openstrata-dev-only
POSTGRES_DB=openstrata
POSTGRES_PORT=5432

# --- Fastify API ---
API_PORT=8080
# HOST=0.0.0.0 binds inside the container; Tailscale provides the access layer.
HOST=0.0.0.0
DATABASE_URL=postgres://openstrata:openstrata-dev-only@db:5432/openstrata

# --- Rosa RAG (pgvector + Ollama) ---
# Ollama endpoint. Local host by default (host.docker.internal); in a multi-node
# tailnet this can be the Ollama host's Tailscale MagicDNS name, e.g.:
#   OLLAMA_BASE_URL=https://ollama-host.tailnet-name.ts.net
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Embedding model (nomic-embed-text = 768 dim; matches migration 0002).
OLLAMA_EMBED_MODEL=nomic-embed-text
# Strict-RAG answer model.
OLLAMA_CHAT_MODEL=llama3.2
# pgvector table/collection prefix for the BC SPA/RTA/CRT corpus (migration 0002).
VECTOR_COLLECTION=bc_spa_rta_crt

# --- Ziggy treasury tuning (development only) ---
CRF_MANDATORY_PCT=10

# --- Auth (multi-tenant councils) ---
# AUTH_SECRET signs the HS256 bearer JWTs — generate a strong value on the host:
#   openssl rand -base64 48
AUTH_SECRET=dev-only-insecure-secret-change-me
AUTH_TOKEN_TTL=43200
# Brute-force throttle for the open auth surface: max failed attempts per
# 15-minute window, keyed per email + per IP. Successful logins clear the bucket.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Reconcile scan window (days) for auto-matching inbound transfers.
RECON_SCAN_DAYS=90

# --- Sovereign payment rails (Bitcoin + Layer-2) ---
# All off by default until the corresponding daemon / service is provisioned
# on the host (or in the operator's tailnet) and pointed at here via .env.
#
# Bitcoin on-chain node (bitcoind / LND) — used to inspect wallets + broadcast.
BITCOIN_RAIL_ENABLED=false
BITCOIN_NODE_URL=http://127.0.0.1:8332
# bitcoind JSON-RPC auth for the on-chain broadcast seam (raw-tx path first;
# PSBT workflow seam is the next step). Match bitcoind rpcuser/rpcpassword, or
# use a cookie file if your bitcoind is configured with rpccookiefile.
BITCOIN_RPC_USER=
BITCOIN_RPC_PASS=

# Lightning via LND. When enabled, quotePayment enforces the LNURL 15-min
# CAD rate-lock window.
LIGHTNING_RAIL_ENABLED=false
LND_URL=grpc://127.0.0.1:10009
LIGHTNING_NETWORK=mainnet

# Liquid Network (Elements) — JSON-RPC / Liquid Service provide asset wallets.
LIQUID_RAIL_ENABLED=false
LIQUID_URL=http://127.0.0.1:7041

# PayNym (BIP-47) — stateless payment notification endpoint.
PAYNYM_RAIL_ENABLED=false
PAYNYM_NOTIFIER_URL=

# Nostr — comma-separated relay list; unit identity / receipts / DMs.
NOSTR_RAIL_ENABLED=false
NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol

# --- Optional: live CAD/BTC rate feed (mempool.space by default) ---
# CAD_PER_BTC= overrides the live provider with a static rate (dev / air-gapped).
# CAD_PER_BTC=165432.15

# --- Tailscale host metadata (optional, for console + MagicDNS) ---
# TAILSCALE_HOSTNAME=openstrata-host   # MagicDNS name hint; set on the host
# TAILSCALE_TAILNET=tailnet-name.ts.net  # the operator's tailnet (per-user)
